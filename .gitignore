.idea/
__pycache__/
*.pyc
.venv/
*.log

# systemctl enable writes these through folded stow links (machines stowed before --no-folding)
*/.config/systemd/user/*.wants/

bat/.config/bat/themes/matugen-bat-colors.tmTheme
fzf/.config/fzf/fzf-colors.conf
micro/.config/micro/colorschemes/matugen.micro
ghostty/.config/ghostty/themes/matugen
/micro/.config/micro/buffers/history
/micro/.config/micro/bindings.json

# zsh package ships nothing into ~/.oh-my-zsh. If stow tree-folding ever recreates
# this folder, keep any plugin clones that land here out of git.
zsh/.oh-my-zsh/
