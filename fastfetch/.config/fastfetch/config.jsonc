{
  "display": {
    "color": {
      "keys": "38;2;255;255;255"
    },
    "key": {
      "width": 14
    },
    "separator": "  "
  },
  "logo": {
    "color": {
      "1": "38;2;255;255;255"
    },
    "padding": {
      "left": 2,
      "top": 2
    },
    "source": "~/.config/fastfetch/logo.txt",
    "type": "file"
  },
  "modules": [
    {
      "color": {
        "at": "38;2;102;102;102",
        "host": "38;2;255;138;138",
        "user": "38;2;255;138;138"
      },
      "type": "title"
    },
    "break",
    {
      "format": "{pretty-name}",
      "key": "  OS",
      "keyColor": "38;2;113;183;255",
      "type": "os"
    },
    {
      "key": " 󰌽 Kernel",
      "keyColor": "38;2;210;168;255",
      "type": "kernel"
    },
    {
      "format": "{pretty-name}",
      "key": "  WM",
      "keyColor": "38;2;255;138;138",
      "type": "wm"
    },
    {
      "format": "{pretty-name}",
      "key": "  Shell",
      "keyColor": "38;2;141;219;140",
      "type": "shell"
    },
    {
      "key": " 󰔚 Uptime",
      "keyColor": "38;2;210;180;95",
      "type": "uptime"
    },
    {
      "format": "{used} / {total}",
      "key": "  Ram",
      "keyColor": "38;2;113;183;255",
      "type": "memory"
    },
    {
      "format": "{pretty-name}",
      "key": " 󰸱 Color",
      "symbol": "circle",
      "type": "colors"
    }
  ]
